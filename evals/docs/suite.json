        "resultSchema": {
          "type": "object",
          "properties": {
            "path": {
              "const": "release-notes.md"
            }
          },
          "required": [
            "path"
          ]
        },
        "files": [
          {
            "path": "release-notes.md",
            "contains": [
              "# ",
              "[CHANGE-101]"
            ]
          }
        ]
      }
    },
